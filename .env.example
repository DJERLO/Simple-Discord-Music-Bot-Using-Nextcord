BOT_TOKEN=your_token_placeholder_here
LAVALINK_URI=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass
# YouTube OAuth2 refresh token used by the Lavalink YouTube source plugin.
# If you don't have a token yet, leave this blank or remove the line and
# restart the Lavalink container to trigger the device authorization flow
# (the container logs will show the device code and instructions).
# See docs/setup/environment-variables.mdx and README.MD for details.
YOUTUBE_REFRESH_TOKEN=your_token_placeholder_here